[Unit]
Description=ezlb - IPVS Load Balancer
Documentation=https://github.com/easzlab/ezlb
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/ezlb
ExecStartPre=/sbin/modprobe ip_vs
ExecStartPre=/sbin/modprobe ip_vs_rr
ExecStartPre=/sbin/modprobe ip_vs_wrr
ExecStartPre=/sbin/modprobe ip_vs_lc
# The ezlb namespace, VIP, interfaces and routes must be provisioned before startup.
ExecStartPre=/usr/sbin/ip netns exec ezlb /sbin/sysctl -w net.ipv4.ip_forward=1
ExecStartPre=/usr/sbin/ip netns exec ezlb /sbin/sysctl -w net.ipv4.vs.conntrack=1
ExecStartPre=/usr/sbin/ip netns exec ezlb /sbin/sysctl -w net.ipv4.conf.all.rp_filter=0
ExecStartPre=/usr/sbin/ip netns exec ezlb /sbin/sysctl -w net.ipv4.conf.default.rp_filter=0
ExecStart=/usr/sbin/ip netns exec ezlb /opt/ezlb/ezlb start --netns-mode=exclusive -c /opt/ezlb/config.yaml
Restart=on-failure
RestartSec=10s
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
